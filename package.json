{
  "name": "epubviewer",
  "description": "EPUB/CBR/PDF reader app for Nextcloud",
  "version": "1.9.16",
  "author": "devnoname120 <devnoname120@gmail.com>",
  "contributors": [
    "devnoname120 <devnoname120@gmail.com>"
  ],
  "bugs": {
    "url": "https://github.com/devnoname120/epubviewer/issues"
  },
  "repository": {
    "url": "https://github.com/devnoname120/epubviewer.git",
    "type": "git"
  },
  "homepage": "https://github.com/devnoname120/epubviewer",
  "license": "agpl",
  "private": true,
  "type": "module",
  "scripts": {
    "lint-github-actions": "go run github.com/rhysd/actionlint/cmd/actionlint@latest",
    "pin-github-actions": "pin-github-action .github/workflows/",
    "update-deps": "npx npm-check-updates",
    "prebuild": "node scripts/prepare-generated-assets.mjs",
    "build": "vite --mode production build",
    "dev": "vite --mode development build",
    "watch": "vite --mode development build --watch",
    "serve": "vite --mode development serve",
    "test": "node --test tests/js/*.test.js",
    "lint": "eslint \"src/**/*.{js,ts,vue}\"",
    "lint:fix": "eslint \"src/**/*.{js,ts,vue}\" --fix",
    "stylelint": "stylelint css/*.css css/*.scss \"src/**/*.{css,scss,vue}\"",
    "stylelint:fix": "stylelint css/*.css css/*.scss \"src/**/*.{css,scss,vue}\" --fix"
  },
  "dependencies": {
    "@mary/rar": "npm:@jsr/mary__rar@0.2.2",
    "@nextcloud/initial-state": "^3.0.0",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/router": "^3.2.0",
    "@nextcloud/vue": "^9.13.1",
    "vue": "^3.5.43"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0",
    "npm": "^10.0.0 || ^11.0.0"
  },
  "overrides": {
    "minimatch": "^10.2.1"
  },
  "devDependencies": {
    "@nextcloud/browserslist-config": "^3.1.2",
    "@nextcloud/stylelint-config": "^3.2.2",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "pin-github-action": "^3.5.2",
    "prettier": "^3.9.9",
    "sass": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.2"
  }
}
